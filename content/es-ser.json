{
  "format": 2,
  "id": "es_ser",
  "learn_lang": "es",
  "level": "A1",
  "title": {
    "en": "I am … (ser): name, origin, describing yourself",
    "es": "Yo soy …: nombre, origen y descripciones",
    "de": "Ich bin … (ser): Name, Herkunft, Beschreibungen"
  },
  "status": "draft — waiting for Nora's check (2026-11-24)",
  "items": [
    {
      "id": "ser_name",
      "group": "name",
      "label": "soy + name",
      "explanation": {
        "en": "To say who you are: (Yo) soy + your name. You can leave out \"yo\": Soy Ana.",
        "es": "Para decir quién eres: (Yo) soy + nombre. Se puede omitir \"yo\": Soy Ana.",
        "de": "So sagst du, wer du bist: (Yo) soy + Name. \"Yo\" kann man weglassen: Soy Ana."
      },
      "distractors": [
        "estoy",
        "es",
        "eres"
      ],
      "examples": [
        {
          "sentence": "Yo ___ Lucas.",
          "answers": [
            "soy"
          ],
          "difficulty": 1
        },
        {
          "sentence": "Hola, ___ Ana.",
          "answers": [
            "soy"
          ],
          "difficulty": 1
        },
        {
          "sentence": "Hola, yo ___ Pablo.",
          "answers": [
            "soy"
          ],
          "difficulty": 1
        },
        {
          "sentence": "¡Buenos días! ___ Marta.",
          "answers": [
            "Soy"
          ],
          "distractors": [
            "Estoy",
            "Tengo",
            "Está"
          ],
          "difficulty": 1
        }
      ]
    },
    {
      "id": "ser_me_llamo",
      "group": "name",
      "label": "me llamo + name",
      "explanation": {
        "en": "Another way to say your name: Me llamo Ana. (= My name is Ana.)",
        "es": "Otra forma de decir tu nombre: Me llamo Ana.",
        "de": "Noch eine Art, deinen Namen zu sagen: Me llamo Ana. (= Ich heiße Ana.)"
      },
      "distractors": [
        "soy",
        "llama",
        "llamas"
      ],
      "examples": [
        {
          "sentence": "Me ___ Sofía.",
          "answers": [
            "llamo"
          ],
          "difficulty": 1
        },
        {
          "sentence": "Hola, me ___ Tom.",
          "answers": [
            "llamo"
          ],
          "difficulty": 1
        },
        {
          "sentence": "Yo me ___ Daniel.",
          "answers": [
            "llamo"
          ],
          "difficulty": 2
        }
      ]
    },
    {
      "id": "ser_origin_soy",
      "group": "origin",
      "label": "soy de + place",
      "explanation": {
        "en": "To say where you are from: Soy de + country or city. Soy de Inglaterra.",
        "es": "Para decir de dónde eres: Soy de + país o ciudad. Soy de Inglaterra.",
        "de": "So sagst du, woher du kommst: Soy de + Land oder Stadt. Soy de Inglaterra."
      },
      "distractors": [
        "estoy",
        "es",
        "eres"
      ],
      "examples": [
        {
          "sentence": "Yo ___ de Inglaterra.",
          "answers": [
            "soy"
          ],
          "difficulty": 1
        },
        {
          "sentence": "___ de Escocia.",
          "answers": [
            "Soy"
          ],
          "distractors": [
            "Estoy",
            "Está",
            "Tengo"
          ],
          "difficulty": 1
