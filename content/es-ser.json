        {
          "sentence": "Me llamo Ana y ___ de Madrid.",
          "answers": [
            "soy"
          ],
          "difficulty": 2
        },
        {
          "sentence": "No ___ de Francia.",
          "answers": [
            "soy"
          ],
          "difficulty": 2,
          "distractors": [
            "estoy",
            "está",
            "tengo"
          ]
        }
      ]
    },
    {
      "id": "ser_origin_de",
      "group": "origin",
      "label": "de (not en) + place",
      "explanation": {
        "en": "Where you are from always uses \"de\": Soy de Irlanda. Not \"en\" (en = in).",
        "es": "El origen siempre va con \"de\": Soy de Irlanda. No \"en\".",
        "de": "Herkunft immer mit \"de\": Soy de Irlanda. Nicht \"en\" (en = in)."
      },
      "distractors": [
        "en",
        "a",
        "por"
      ],
      "examples": [
