    {
      "id": "pf_have_has",
      "group": "form",
      "label": "have / has + 3rd form",
      "explanation": {
        "en": "have/has + the 3rd form of the verb: I have finished, she has eaten. he/she/it → has, everyone else → have.",
        "de": "have/has + 3. Form des Verbs: I have finished, she has eaten. Bei he/she/it has, sonst have. Das ist das Present Perfect.",
        "es": "have/has + participio (la 3.ª forma): I have finished, she has eaten. Con he/she/it, has; con los demás, have. Es el present perfect."
      },
      "examples": [
        {
          "sentence": "She ___ just finished her homework.",
          "answers": [
            "has"
          ],
          "distractors": [
            "have",
            "is",
            "did"
          ],
          "difficulty": 1
        },
        {
          "sentence": "I ___ already eaten my lunch.",
          "answers": [
            "have"
          ],
          "distractors": [
            "has",
            "am",
            "did"
          ],
          "difficulty": 1
        },
        {
          "sentence": "We ___ never been to Paris.",
          "answers": [
            "have"
          ],
          "distractors": [
            "has",
            "are",
            "did"
          ],
          "difficulty": 1
        },
        {
