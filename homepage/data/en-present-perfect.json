    {
      "id": "pf_already_yet",
      "group": "already_yet",
      "label": "already / yet",
      "explanation": {
        "en": "already = sooner than you think (in yes-sentences): I've already finished. yet = until now (at the end of questions and no-sentences): Have you finished yet? I haven't finished yet.",
        "de": "already = schon (in bejahten Sätzen): I've already finished. yet = schon / noch (am Satzende, in Fragen und verneinten Sätzen): Have you finished yet? I haven't finished yet.",
        "es": "already = ya (en frases afirmativas): I've already finished. yet = ya / todavía (al final, en preguntas y negaciones): Have you finished yet? I haven't finished yet."
      },
