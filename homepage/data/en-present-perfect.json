    {
      "id": "pf_short_forms",
      "group": "form",
      "label": "I've / she's / they've",
      "explanation": {
        "en": "Short forms: I have → I've, she has → she's, they have → they've. I've seen it (not 'I'm seen it').",
        "de": "Kurzformen: I have → I've, she has → she's, they have → they've. I've seen it (nicht 'I'm seen it').",
        "es": "Formas cortas: I have → I've, she has → she's, they have → they've. I've seen it (no 'I'm seen it')."
      },
      "examples": [
        {
          "sentence": "I want to see a whale one day. ___ never seen one.",
          "answers": [
            "I've",
            "I have"
          ],
          "distractors": [
            "I'm",
            "I",
            "I did"
          ],
          "difficulty": 2
        },
        {
          "sentence": "Where's Mia? – ___ already gone home.",
          "answers": [
            "She's",
            "She has"
          ],
          "distractors": [
            "She have",
            "She",
            "She did"
          ],
          "difficulty": 3
        },
        {
          "sentence": "Look at Tom and Sara! ___ painted the door blue.",
          "answers": [
            "They've",
            "They have"
          ],
          "distractors": [
            "They're",
            "They",
            "They has"
          ],
          "difficulty": 3
        }
      ]
    },
    {
      "id": "pf_regular",
      "group": "participle",
      "label": "have cleaned, has visited",
      "explanation": {
        "en": "For regular verbs, the 3rd form looks like the past: clean → cleaned → cleaned, visit → visited → visited.",
        "de": "Bei regelmäßigen Verben sieht die 3. Form aus wie die Vergangenheit: clean → cleaned → cleaned, visit → visited → visited.",
        "es": "En los verbos regulares, la 3.ª forma es igual que el pasado: clean → cleaned → cleaned, visit → visited → visited."
      },
